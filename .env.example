# Tandem Source credentials for `harmonic fetch`.
# Copy to `.env` and fill in. `.env` is gitignored — never commit real creds.
# These are read by upstream tconnectsync's `secret` module from the cwd `.env`.

TCONNECT_EMAIL=you@example.com
TCONNECT_PASSWORD=your-tconnect-password

# US or EU — which Tandem Source region your account lives in.
TCONNECT_REGION=US

# The timezone your PUMP is set to. This sets the wall-clock that every record
# is bucketed by, so a basal *profile* (a wall-clock schedule) lines up. Use a
# tz database name, e.g. America/New_York, America/Chicago, Europe/London.
TIMEZONE_NAME=America/New_York

# Optional: pin a specific pump by serial if your account has more than one.
# Leave unset to auto-pick the most recently active pump.
# PUMP_SERIAL_NUMBER=1234567

# Optional Harmonic server configuration. HARMONIC_* is canonical; CIQ_* names
# remain a deprecated compatibility fallback for existing deployments.
# HARMONIC_API_TOKEN=change-me-to-a-long-random-string
# HARMONIC_NO_FETCH=1
# HARMONIC_DB=tconnect-data/ciq.db
# HARMONIC_SECRET_KEY=tconnect-data/secret.key
