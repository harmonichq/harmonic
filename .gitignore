# Pyre type checker
.pyre/

# Personal health data — never commit (PHI: CGM readings, pump serial, etc.)
tconnect-data/
# …and the bare name too: the trailing-slash rule matches a directory only, so a
# worktree that reaches the snapshot through a SYMLINK named tconnect-data was
# left trackable by it.
tconnect-data

# Real /scenarios payload captures for mockup review — contain real CGM/times (PHI).
# The #64 mockups fetch this locally; never commit it (see #64 "Zero PHI committed").
mockups/*.capture.json
# Review screenshots render that same real data — equally PHI, never commit.
mockups/*.png
# EXCEPTION: behaviour-sweep renders under mockups/sweep/<surface>/ DO commit,
# even though they render real captures.
# The rule above would not have covered them anyway — it does not cross a slash.
# The raw capture JSON is still never committed.

# Local git worktrees for parallel work — never commit (they're full checkouts
# of other branches, registered via `git worktree`).
worktrees/

# Local agent-tool state: scratch directories, per-task worktrees, per-developer
# editor and assistant settings, and any dependencies such tools install. None
# of it belongs to the project, and it differs from one contributor to the next.
.agentflow/
.codex/worktrees/
.claude/worktrees/
.claude/settings.local.json
.agents/skills/**/node_modules/
.claude/skills/**/node_modules/

# #394 screenshot harness scratch (pre-change builder copy)
frontend/.chart-builders.before.mjs

# macOS Finder metadata
.DS_Store
