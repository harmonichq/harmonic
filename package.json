{
  "name": "harmonic",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --config vite.config.mjs",
    "build": "vite build --config vite.config.mjs",
    "storybook": "storybook dev -c frontend/ui/.storybook -p 6006",
    "build-storybook": "storybook build -c frontend/ui/.storybook -o frontend/ui/storybook-static --quiet",
    "test:ui": "tsc -p frontend/ui && npm run build-storybook && node scripts/ui-stories.mjs check",
    "shots": "npm run build-storybook && node scripts/ui-stories.mjs shots"
  },
  "devDependencies": {
    "@babel/parser": "7.29.8",
    "@storybook/react-vite": "10.6.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "storybook": "10.6.1",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "dependencies": {
    "echarts": "5.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
